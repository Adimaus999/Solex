import sqlite3
from datetime import datetime

# Connect to the SQLite database (or create it if it doesn't exist)
conn = sqlite3.connect('log.db')
c = conn.cursor()

# Create a table to store the log data
c.execute('''
CREATE TABLE IF NOT EXISTS log (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    timestamp TEXT,
    speed REAL,
    position TEXT
)
''')

# Function to log data
def log_data(speed, position):
    timestamp = datetime.now().isoformat()
    c.execute('INSERT INTO log (timestamp, speed, position) VALUES (?, ?, ?)', (timestamp, speed, position))
    conn.commit()

# Example usage
log_data(30.5, '50.1234, -1.2345')
log_data(28.7, '50.5678, -1.6789')

# Close the connection when done
conn.close()